# ==============================================================================
# RESONANCE CAMPUS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in the root directory and fill in your values:
# cp .env.example .env
# ==============================================================================

# Application Environment (development / staging / production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=resonance_db

# Security & JWT (Generate a unique 32+ character random string in production)
JWT_SECRET=your_32_character_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth Credentials
# Retrieve from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Music Provider Configuration (Audius legal open protocol)
AUDIUS_APP_NAME=ResonanceCampus

# Mobile App Versioning & Direct Distribution
APP_VERSION=1.0.0
MIN_SUPPORTED_VERSION=1.0.0
APK_DOWNLOAD_URL=https://github.com/Rajdeep-Mudiar/Music_App/releases/latest/download/app-release.apk
RELEASE_NOTES=Initial release of Resonance with Music Streaming, Campus Communities, and Study Mode.
